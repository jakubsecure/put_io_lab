<?xml version="1.0" encoding="UTF-8"?>
<project name="bank-zbozowy" default="dist">
    <property name="src.dir" location="src"/>
    <property name="res.dir" location="res"/>
    <property name="bin.dir" location="bin"/>
    <property name="dist.dir" location="dist"/>
    <property name="lib.dir" location="lib"/>
    <property name="app.jar" location="${dist.dir}/bank.jar"/>

    <!-- Biblioteki potrzebne kompilatorowi. Nazw JAR-ów nie trzeba przepisywać. -->
    <path id="compile.cp">
        <fileset dir="${lib.dir}" includes="*.jar"/>
    </path>
    <!-- JVM potrzebuje bibliotek ORAZ klas i zasobów naszej aplikacji. -->
    <path id="run.cp">
        <path refid="compile.cp"/>
        <pathelement location="${app.jar}"/>
    </path>

    <target name="init" description="Utwórz katalogi wynikowe">
        <mkdir dir="${bin.dir}"/>
        <mkdir dir="${dist.dir}"/>
    </target>
    <!-- TODO: dodaj depends do compile, copy, dist i run. -->
    <target name="compile" depends="init" description="Skompiluj źródła Java">
        <!-- TODO: zastąp fail zadaniem javac ze ściągi. -->
	<javac srcdir="${src.dir}" destdir="${bin.dir}" release="21"	
	       includeantruntime="false" encoding="UTF-8" classpathref="compile.cp"/>
    </target>
    <target name="copy" depends="init" description="Skopiuj szablony do katalogu wynikowego">
        <!-- TODO: zastąp fail zadaniem copy ze ściągi. -->
	<copy todir="${bin.dir}">
	    <fileset dir="${res.dir}"/>
	</copy>
    </target>
    <target name="dist" depends="compile, copy" description="Spakuj klasy i zasoby do JAR-a">
        <!-- TODO: zastąp fail zadaniem jar ze ściągi. -->
	    <jar destfile="${app.jar}">
		    <fileset dir="${bin.dir}"/>
		</jar>

    </target>
    <target name="run" depends="dist"  description="Uruchom serwer na porcie 9090; zatrzymaj Ctrl+C">
        <java classname="put.io.selenium.atm.SimpleServer"
              classpathref="run.cp" fork="true" failonerror="true"/>
    </target>
    <target name="clean" description="Usuń tylko wyniki budowania">
        <delete dir="${bin.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>
</project>
